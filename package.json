{
  "name": "@dtelecom/server-sdk-js",
  "version": "2.0.6",
  "description": "Server-side SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "git@github.com:dTelecom/server-sdk-js.git",
  "author": "",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js",
      "require": "./dist/contract/index.js"
    },
    "./contract/*": {
      "types": "./dist/contract/*.d.ts",
      "import": "./dist/contract/*.js",
      "require": "./dist/contract/*.js"
    },
    "./proto/*": {
      "types": "./dist/proto/*.d.ts",
      "import": "./dist/proto/*.js",
      "require": "./dist/proto/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.main.json",
    "build:watch": "tsc --watch",
    "build-docs": "typedoc",
    "proto": "./generate-proto.sh",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "npm run build",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.0",
    "axios": "^1.8.4",
    "bs58": "^5.0.0",
    "camelcase-keys": "^7.0.0",
    "fast-jwt": "^5.0.5",
    "ip-to-int": "^0.3.1",
    "jsonwebtoken": "^9.0.2",
    "protobufjs": "^7.5.0",
    "rpc-websockets": "^7.5.1"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/geoip-lite": "^1.4.1",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^4.29.1",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.24.0",
    "jest": "^29.7.0",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^8.0.11",
    "ts-node": "^9.1.1",
    "ts-proto": "^1.131.0",
    "typedoc": "^0.28.2",
    "typescript": "5.7.x"
  }
}
